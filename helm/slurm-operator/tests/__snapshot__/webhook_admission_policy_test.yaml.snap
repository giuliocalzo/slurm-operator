  3: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: test-release
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: slurm-operator-webhook
        app.kubernetes.io/part-of: slurm-operator
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: slurm-operator-1.2.3
      name: test-release-slurm-operator-controller
    spec:
      failurePolicy: Fail
      matchConstraints:
        matchPolicy: Equivalent
        resourceRules:
          - apiGroups:
              - slinky.slurm.net
            apiVersions:
              - v1beta1
            operations:
              - CREATE
              - UPDATE
            resources:
              - controllers
            scope: Namespaced
      validations:
        - expression: oldObject != null || variables.clusterName.size() <= 40
          messageExpression: '''ClusterName exceeds 40 characters ('' + string(variables.clusterName.size()) + ''): '' + variables.clusterName'
        - expression: oldObject == null || variables.clusterName == variables.oldClusterName
          message: cannot change ClusterName after deployment
        - expression: oldObject == null || object.spec.?slurmKeyRef.?name.orValue('') == oldObject.spec.?slurmKeyRef.?name.orValue('')
          message: cannot change SlurmKeyRef after deployment
        - expression: oldObject == null || object.spec.?jwtKeyRef.or(object.spec.?jwtHs256KeyRef) == oldObject.spec.?jwtKeyRef.or(oldObject.spec.?jwtHs256KeyRef)
          message: the value of JwtKeyRef or JwtHs256KeyRef cannot be modified after deployment
        - expression: oldObject == null || object.spec.?persistence.?enabled == oldObject.spec.?persistence.?enabled
          message: cannot change persistence.enabled after deployment
        - expression: oldObject == null || !object.spec.?persistence.?enabled.orValue(true) || object.spec.?persistence.?existingClaim.orValue('') == oldObject.spec.?persistence.?existingClaim.orValue('')
          message: cannot change persistence.existingClaim after deployment
      variables:
        - expression: 'object.spec.?clusterName.orValue('''') != '''' ? object.spec.clusterName : request.namespace + ''_'' + object.metadata.name'
          name: clusterName
        - expression: 'oldObject.spec.?clusterName.orValue('''') != '''' ? oldObject.spec.clusterName : oldObject.metadata.namespace + ''_'' + oldObject.metadata.name'
          name: oldClusterName
