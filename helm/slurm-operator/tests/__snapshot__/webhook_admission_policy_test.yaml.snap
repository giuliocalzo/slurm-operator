  13: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: test-release
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: slurm-operator-webhook
        app.kubernetes.io/part-of: slurm-operator
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: slurm-operator-1.2.3
      name: test-release-slurm-operator-nodeset
    spec:
      failurePolicy: Fail
      matchConstraints:
        matchPolicy: Equivalent
        resourceRules:
          - apiGroups:
              - slinky.slurm.net
            apiVersions:
              - v1beta1
            operations:
              - CREATE
              - UPDATE
            resources:
              - nodesets
            scope: Namespaced
      validations:
        - expression: object.spec.?controllerRef.?name.orValue('') != ''
          message: controllerRef.name must not be empty
        - expression: '!variables.maxUnavailable.hasValue() || type(variables.maxUnavailable.value()) != int || variables.maxUnavailable.value() >= 1'
          messageExpression: '''maxUnavailable must be > 0, got '' + string(int(variables.maxUnavailable.value()))'
        - expression: '!variables.maxUnavailable.hasValue() || type(variables.maxUnavailable.value()) != string || variables.maxUnavailable.value() != ''0%'''
          message: maxUnavailable must not be 0%
        - expression: duration(variables.scheduledDuration) == duration('0s') || duration(variables.scheduledDuration) >= duration('1m')
          message: UpdateStrategy.ScheduledUpdate.Duration must be at least 1 minute
        - expression: '!object.spec.?ssh.?enabled.orValue(false) || object.spec.?ssh.?sssdConfRef.?name.orValue('''') != '''''
          message: ssh.sssdConfRef.name must not be empty when ssh is enabled
        - expression: variables.hostname == '' || !format.dns1123Subdomain().validate(variables.hostname).hasValue()
          messageExpression: '''template.spec.hostname: '' + format.dns1123Subdomain().validate(variables.hostname).value().join(''; '')'
        - expression: variables.malformedExtraConf.size() == 0
          messageExpression: '''invalid extraConf: malformed --conf item "'' + variables.malformedExtraConf[0] + ''": expected Key=Value'''
        - expression: oldObject == null || object.spec.?controllerRef == oldObject.spec.?controllerRef
          message: cannot change controllerRef after deployment
        - expression: oldObject == null || object.spec.?volumeClaimTemplates.orValue([]) == oldObject.spec.?volumeClaimTemplates.orValue([])
          message: cannot change volumeClaimTemplates after deployment
      variables:
        - expression: object.spec.?updateStrategy.?rollingUpdate.?maxUnavailable
          name: maxUnavailable
        - expression: object.spec.?updateStrategy.?scheduledUpdate.?duration.orValue('0s')
          name: scheduledDuration
        - expression: 'object.spec.?template.?spec.?hostname.orValue('''').size() > 1 && object.spec.template.spec.hostname.endsWith(''-'') ? object.spec.template.spec.hostname.substring(0, object.spec.template.spec.hostname.size() - 2) + ''a'' : object.spec.?template.?spec.?hostname.orValue('''')'
          name: hostname
        - expression: object.spec.?extraConf.orValue('').findAll('\\S+').filter(i, !i.contains('='))
          name: malformedExtraConf
