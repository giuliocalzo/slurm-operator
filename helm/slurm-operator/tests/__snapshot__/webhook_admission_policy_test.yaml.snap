pods/binding policy should match snapshot:
  1: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: MutatingAdmissionPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: test-release
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: slurm-operator-webhook
        app.kubernetes.io/part-of: slurm-operator
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: slurm-operator-1.2.3
      name: test-release-slurm-operator-pods-binding
    spec:
      failurePolicy: Ignore
      matchConstraints:
        matchPolicy: Equivalent
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
            resources:
              - pods/binding
      mutations:
        - applyConfiguration:
            expression: |-
              variables.topologySpec.hasValue() ? Object{
                  metadata: Object.metadata{
                    annotations: {'topology.slinky.slurm.net/spec': variables.topologySpec.value()}
                  }
                }
              : Object{}
          patchType: ApplyConfiguration
      paramKind:
        apiVersion: v1
        kind: Node
      reinvocationPolicy: Never
      variables:
        - expression: 'params.metadata.name == object.target.name ? params.metadata.?annotations[?''topology.slinky.slurm.net/spec''] : optional.none()'
          name: topologySpec
  2: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: MutatingAdmissionPolicyBinding
    metadata:
      labels:
        app.kubernetes.io/instance: test-release
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: slurm-operator-webhook
        app.kubernetes.io/part-of: slurm-operator
        app.kubernetes.io/version: 1.2.3
        helm.sh/chart: slurm-operator-1.2.3
      name: test-release-slurm-operator-pods-binding
    spec:
      matchResources:
        namespaceSelector:
          matchExpressions:
            - key: kubernetes.io/metadata.name
              operator: NotIn
              values:
                - kube-system
                - kube-public
                - kube-node-lease
                - test-namespace
      paramRef:
        parameterNotFoundAction: Allow
        selector: {}
      policyName: test-release-slurm-operator-pods-binding
